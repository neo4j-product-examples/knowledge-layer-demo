# Local Desktop DBMS hosting the meridianComposite composite database
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=changeme
NEO4J_COMPOSITE_DB=meridiancomposite

# Bloom/Explore URL for the shadowDb Aura instance (Aura Console -> instance -> Open with -> Explore)
BLOOM_URL=https://console-preview.neo4j.io/projects/<your-project-id>/studio/bloom

# Powers the real chat (tool-use loop) in /api/chat. Get one at
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=changeme
